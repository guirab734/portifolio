# Template das variaveis de ambiente. O .env real fica fora do versionamento.

# Token do GitHub consumido pelo MCP shadcn-ui para ler o repo shadcn-ui/ui.
# Opcional - sem ele o limite cai para 60 requisicoes por hora.
# Escopo: leitura publica (public_repo / Contents: read).
GITHUB_TOKEN=

# Chave da API do 21st.dev, usada pelo MCP magic na geracao de componentes.
# Console: https://21st.dev/magic/console
TWENTY_FIRST_API_KEY=
