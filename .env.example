# Copie este arquivo para .env e preencha com suas chaves reais.
# O .env esta no .gitignore e NUNCA deve ser commitado.

# Token do GitHub (classic ou fine-grained).
# Usado pelo MCP shadcn-ui para ler componentes do repo shadcn-ui/ui.
# Sem ele o servidor funciona, mas limitado a 60 requisicoes/hora.
# Escopo necessario: apenas leitura publica (public_repo / Contents: read).
GITHUB_TOKEN=

# Chave da API do 21st.dev, usada pelo MCP "magic" (geracao de componentes UI).
# Obtenha em: https://21st.dev/magic/console
TWENTY_FIRST_API_KEY=
